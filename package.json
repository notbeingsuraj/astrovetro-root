{
  "name": "astrovetro-root-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Astro Vetro — static design served with an API proxy to the Astro Vetro backend (localhost:5002).",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node -e \"console.log('Astro Vetro has no build step. public/ is plain HTML/CSS/JS and is served as-is by server.js; nothing to compile.')\"",
    "test": "node --test tests/",
    "smoke:admin": "node scripts/smoke-admin.mjs",
    "review:images": "node scripts/generate-image-review.mjs",
    "migrate:catalogue": "node scripts/migrate-catalogue.mjs",
    "migrate:users": "node scripts/migrate-users.mjs",
    "backup:db": "node scripts/backup-db.mjs",
    "backup:media": "node scripts/backup-media.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.4",
    "razorpay": "^2.9.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.5",
    "@aws-sdk/client-s3": "^3.450.0",
    "@aws-sdk/s3-request-presigner": "^3.450.0"
  }
}

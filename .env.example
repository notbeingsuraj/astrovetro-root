# Astrovetro Studio — environment template
# Copy to .env for local development. Never commit a real .env.

NODE_ENV=development
PORT=5173
FRONTEND_URL=http://localhost:5173

# Trust proxy setting — REQUIRED when running behind a reverse proxy (nginx,
# Vercel, AWS ALB, Cloudflare, etc.) so that req.ip and rate limiting see the
# real client IP. Set to:
#   1, true       - trust first hop (single proxy: Vercel, Heroku, Railway)
#   2             - trust two hops (Cloudflare -> nginx)
#   loopback      - trust loopback only (localhost dev)
#   linklocal     - trust link-local addresses only
#   uniquelocal   - trust unique local addresses only
#   <IP>,<CIDR>   - explicit trusted proxy IPs/CIDRs (comma-separated)
# Omit or leave empty in development with no proxy.
# Invalid values will cause startup failure.
TRUST_PROXY=1

# Storage adapter for media uploads. Default: local (uses public/assets/img/).
# Options: local, s3
# Invalid values will cause startup failure.
# STORAGE_ADAPTER=local

# S3-compatible storage (Cloudflare R2, AWS S3, MinIO, etc.) — required when STORAGE_ADAPTER=s3
# S3_BUCKET=your-bucket-name
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_ENDPOINT=          # optional, for R2/MinIO (e.g., https://<account>.r2.cloudflarestorage.com)
# STORAGE_PUBLIC_URL=   # optional public base URL for generated image URLs (e.g., https://cdn.example.com)

# Backblaze B2 (S3‑compatible) — required when STORAGE_ADAPTER=b2
# B2_BUCKET_NAME=your-bucket-name
# B2_KEY_ID=your-key-id
# B2_APPLICATION_KEY=your-application-key
# B2_ENDPOINT=          # optional, for R2/MinIO (e.g., https://<account>.r2.cloudflarestorage.com)
# B2_REGION=us-west-004

# MongoDB connection (Atlas SRV). Replace with your own Atlas URI.
# The Studio (products, collections, rituals, journal, website content) needs it.
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/astrovetro_staging
# Alias also read when DATABASE_URL is absent.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/astrovetro_staging

# Required in production, at least 32 characters. Development falls back to a
# generated local secret, which must never be used on a shared host.
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional. Payment confirmation remains server-side only; without these keys
# checkout refuses instead of pretending a payment succeeded.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Used only by scripts/create-admin.mjs when creating or resetting an admin
# password non-interactively. The server never reads this value.
# AV_ADMIN_PASSWORD=

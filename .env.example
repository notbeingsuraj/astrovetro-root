# Astro Vetro — Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env to version control.

# =============================================================================
# SERVER
# =============================================================================
NODE_ENV=development
PORT=5173

# =============================================================================
# FRONTEND
# =============================================================================
# Comma-separated origins allowed to send credentialed requests.
# In production, must be explicitly configured. No wildcard, no localhost fallback.
# Example: FRONTEND_URL=https://astrovetro.com,https://www.astrovetro.com
FRONTEND_URL=http://localhost:5173

# =============================================================================
# DATABASE
# =============================================================================
# MongoDB connection string. Required for accounts, orders, cart, wishlist.
# Local example: DATABASE_URL=mongodb://localhost:27017/astrovetro_dev
# Atlas example: DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/astrovetro_production
DATABASE_URL=

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Secret for signing JWT tokens. Must be at least 32 characters in production.
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# =============================================================================
# PAYMENT PROVIDER
# =============================================================================
# Select the active payment provider: 'cashfree' or 'razorpay'
# If not set, defaults to cashfree if configured, otherwise razorpay.
PAYMENT_PROVIDER=cashfree

# ---- Cashfree Payments (Primary) ----
# Get credentials from https://merchant.cashfree.com/
# Sandbox: CASHFREE_ENV=sandbox
# Production: CASHFREE_ENV=production
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# ---- Razorpay Payments (Fallback/Alternative) ----
# Get credentials from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# =============================================================================
# REDIS / RATE LIMITING
# =============================================================================
# Upstash Redis for distributed rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to 'true' to allow in-memory rate limiting in production (NOT RECOMMENDED)
DISABLE_RATE_LIMIT=false

# =============================================================================
# STORAGE
# =============================================================================
# Storage adapter: 'local', 's3', or 'b2'
STORAGE_ADAPTER=local

# S3 / B2 configuration (when STORAGE_ADAPTER=s3 or b2)
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET_NAME=
# B2_ENDPOINT=
# B2_REGION=
# STORAGE_PUBLIC_URL=

# =============================================================================
# TRUST PROXY
# =============================================================================
# Required when running behind a reverse proxy (Vercel, nginx, ALB, Cloudflare)
# '1' = trust first hop (Vercel, Heroku)
# '2' = trust two hops (Cloudflare -> nginx)
# 'loopback' = trust loopback only (localhost dev)
TRUST_PROXY=1